+/* The function forms of mvwaddstr and mvwaddnstr in macOS's system
+   ncurses do not write anything, so expand them as the ncurses macros
+   would.  */
+#if defined (__APPLE__) && defined (NCURSES_SUF_ABI60)
+#undef mvwaddstr
+#define mvwaddstr(w, y, x, s) \
+  (wmove ((w), (y), (x)) == ERR ? ERR : waddnstr ((w), (s), -1))
+#undef mvwaddnstr
+#define mvwaddnstr(w, y, x, s, n) \
+  (wmove ((w), (y), (x)) == ERR ? ERR : waddnstr ((w), (s), (n)))
+#endif
+
